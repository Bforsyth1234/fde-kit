# Copy to .env and fill in. All FDE_* keys have defaults; see src/fde_kit/config.py.

ANTHROPIC_API_KEY=
# Only needed if your key is an org-level key not scoped to a workspace:
ANTHROPIC_WORKSPACE_ID=

FDE_PROVIDER=anthropic          # anthropic | mock
FDE_MODEL=claude-sonnet-5-5
FDE_MAX_TURNS=10

FDE_OTEL_ENABLED=true
FDE_OTEL_ENDPOINT=http://localhost:6006/v1/traces
FDE_OTEL_SERVICE_NAME=fde-kit

FDE_EVAL_PASS_THRESHOLD=0.85
